# Copie ce fichier en ".env" et renseigne les vraies valeurs.
# Ne jamais committer le fichier ".env" dans un dépôt Git.

DB_HOST=192.168.0.204
DB_PORT=1539
DB_SID=ace
DB_USER=ace
DB_PASSWORD=change_moi

# Facultatif : chemin de la base des comptes utilisateurs (getly_users.db).
# Par défaut elle est créée à la racine du projet. Ne définis cette variable
# que si ce dossier n'est pas inscriptible par l'utilisateur qui exécute
# l'application (ex. service systemd durci) : pointe alors vers un dossier
# accessible en écriture.
# GETLY_USERS_DB=/var/lib/getly/getly_users.db
